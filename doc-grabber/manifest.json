{
  "manifest_version": 3,
  "name": "Jagema's Doc Grabber",
  "version": "1.2.0",
  "description": "Find PDFs and scanned document pages on any webpage and download them as one searchable PDF (built-in OCR).",
  "permissions": [
    "sidePanel",
    "scripting",
    "downloads",
    "activeTab",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Jagema's Doc Grabber (Alt+Shift+D)"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Open Jagema's Doc Grabber"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
